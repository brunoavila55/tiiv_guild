{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.user_id, m.nickname, m.rank_id, r.name AS rank_name,\n                  m.status::text AS \"status!\", m.joined_at\n             FROM guild_members m JOIN guild_ranks r ON r.id = m.rank_id\n            WHERE m.status <> 'left'\n            ORDER BY r.position, lower(m.nickname)",
