{
  "db_name": "PostgreSQL",
  "query": "SELECT h.id, h.action, h.payload, a.nickname AS \"actor_nickname?\", h.at\n             FROM member_history h\n             LEFT JOIN guild_members a ON a.id = h.actor_member_id\n            WHERE h.member_id = $1\n            ORDER BY h.at DESC, h.id DESC\n            LIMIT 200",
