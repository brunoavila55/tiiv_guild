# Copie para `.env` (raiz, usado pelo docker compose) e `backend/.env` (usado pelo `cargo run`).
# Apenas placeholders: troque todos os valores.

POSTGRES_DB=guildos
POSTGRES_USER=guildos
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# Porta pública do Traefik
HTTP_PORT=8000

# API (cargo run, fora do docker)
DATABASE_URL=postgres://guildos:change-me@localhost:5432/guildos
API_BIND_ADDR=0.0.0.0:8080
RUST_LOG=api=debug,tower_http=info

# E-mails (separados por vírgula) com acesso ao painel da plataforma (catálogo de jogos)
SUPERADMIN_EMAILS=admin@example.com
