# Copie para `.env` (docker compose) e `backend/.env` (cargo run). Só placeholders.

POSTGRES_DB=guildos
POSTGRES_USER=guildos
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# API
DATABASE_URL=postgres://guildos:change-me@localhost:5432/guildos
API_BIND_ADDR=127.0.0.1:8080
RUST_LOG=api=debug,tower_http=info

# Tenants em {slug}.BASE_DOMAIN. Em dev, *.localhost resolve para 127.0.0.1 sem DNS.
BASE_DOMAIN=guildos.localhost
# Domain do cookie de sessão (padrão: BASE_DOMAIN).
# COOKIE_DOMAIN=guildos.localhost
# Em dev (http) o cookie não pode ser Secure.
COOKIE_SECURE=false

# E-mails (separados por vírgula) com acesso a admin.BASE_DOMAIN
SUPERADMIN_EMAILS=admin@example.com
